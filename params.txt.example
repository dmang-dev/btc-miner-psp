# btc-miner-psp params.txt
#
# Copy this file to your memory stick at:
#   ms0:/PSP/SAVEDATA/btc-miner-psp/params.txt
# (the same directory the EBOOT.PBP gets installed to / next to it)
#
# Format: one `key=value` per line. '#' starts a comment.
# Each key is independent — leave any line out to keep the compiled
# default for that field. Unknown keys are silently ignored.

host=solo.ckpool.org
port=3333
user=bc1qexamplebtcaddressgoeshere.psp
pass=x

# TLS: yes / no / true / false / 1 / 0 (default no).
# Pools that accept TLS typically listen on a separate port (often 443,
# 3334, or 8443) and announce themselves as `stratum+tls://host:port`.
#tls=yes

# TLS certificate verification: yes / no (default yes when TLS is on).
# When on, mbedtls checks the pool's cert chain against the embedded
# Mozilla CA bundle (~189 KB, 121 roots) AND matches the cert's
# CN/SAN against the configured `host=`. Set to `no` only for testing
# against self-signed pools or when you've audited the network path
# yourself. See README's "Security note" section.
#tls_verify=yes

# Offline benchmark mode (since v0.7): yes / no (default no).
# When on, the miner skips all network init and just runs the SHA-256d
# hot loop against a synthetic 80-byte header forever, displaying the
# live H/s on screen. Use this to compare hashrate between build
# versions without needing a pool connection. Press Home to exit.
#bench=yes

# Benchmark sub-mode (since v0.7.1): yes / no (default no).
# Only meaningful when bench=yes. When yes, runs the v0.5-style
# 3-compression-per-nonce loop instead of the v0.6+ midstate-optimized
# 2-compression loop. Same binary in both cases; flip this flag to
# measure the midstate optimization's contribution in isolation.
#bench_naive=yes
